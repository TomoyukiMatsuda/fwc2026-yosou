{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fifa-wcup2026",
  "main": ".open-next/worker.js",
  // nodejs_compat 必須。compatibility_date は 2025-04-01 以上にして
  // wrangler.jsonc の vars を process.env から参照可能にする。
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // アプリは env.DB を使う（src/db/client.ts）。binding は必ず "DB"。
      "binding": "DB",
      "database_name": "fifa-wcup2026-db",
      "database_id": "585e1526-099f-4ab2-a355-9df1e38c2b28",
      "migrations_dir": "drizzle"
    }
  ]
}
